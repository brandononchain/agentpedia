{
  "name": "skilldex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "python3 tools/build_index.py && node tools/cert_sign.mjs && next dev -H 0.0.0.0 -p 43123",
    "build": "python3 tools/build_index.py && node tools/cert_sign.mjs && next build",
    "test:certs": "PYTHONPATH=tools python3 -m pytest tools/tests -q && node --test tools/cert_sign.test.mjs",
    "start": "next start -H 0.0.0.0 -p 43123",
    "lint": "eslint",
    "index": "python3 tools/build_index.py",
    "lint:skills": "PYTHONPATH=tools/skill-lint python3 -m skill_lint skills",
    "test:lint": "PYTHONPATH=tools/skill-lint python3 -m pytest tools/skill-lint/tests -q",
    "new-skill": "python3 tools/new_entry.py skill",
    "new-agent": "python3 tools/new_entry.py agent"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
